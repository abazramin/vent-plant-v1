


datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}



model Plants {
  id String @id @default(cuid())
  name String
  description String?
  category String
  stock Int 
  price Float 
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  userId String 
  imageUrl String?
}


model User {
  id          String   @id @default(cuid())
  stackUserId String   @unique
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}